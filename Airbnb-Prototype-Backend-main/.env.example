NODE_ENV=development
PORT=4000

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=lantern_stay
# Set true only if Postgres requires TLS (managed clouds). Leave false for local/VPS Postgres.
DB_SSL=false
# Set true to auto-seed when the server starts (useful for first production deploy).
SEED_ON_START=false

# JWT — generate with: openssl rand -base64 64
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long!
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Cookie
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# CORS — comma-separated origins
CORS_ORIGINS=http://localhost:3000

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
AUTH_RATE_LIMIT_MAX=20

# App
APP_NAME=The Lantern Stay
BCRYPT_ROUNDS=12

# Optional schema helpers
DB_SYNCHRONIZE=false
DB_LOGGING=false

# WhatsApp (Baileys) — admin gets booking alerts here
ADMIN_NOTIFY_PHONE=9779849783047
WHATSAPP_AUTH_DIR=./whatsapp-auth
